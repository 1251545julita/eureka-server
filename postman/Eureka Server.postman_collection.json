                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/clientes/2/cuentas/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes",
                "2",
                "cuentas",
                "2"
              ]
            },
            "description": "Igual que en la Clase 16, pero la direccion la resolvio Eureka."
          },
          "response": []
