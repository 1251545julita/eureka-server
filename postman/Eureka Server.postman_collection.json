        {
          "name": "5. Cuentas que no existe - 404",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devuelve 404\", function () {\n    pm.response.to.have.status(404);\n});"
