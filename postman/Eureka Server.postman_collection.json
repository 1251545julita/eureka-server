        {
          "name": "6. Crear cuenta - 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Devuelve 201\", function () {\n    pm.response.to.have.status(201);\n});\npm.test(\"Queda APROBADO\", function () {\n    pm.expect(pm.response.json().estado).to.eql(\"APROBADO\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tipo\": \"Cuenta Corriente\",\n  \"moneda\": \"USD\",\n  \"clienteId\": \"2\",\n  \"saldoInicial\": 0.00,\n  \"limiteDescubierto\": 100000.00\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/clientes/cuentas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "clientes",
                "cuentas"
              ]
            },
            "description": "Dos llamados de pagos a clientes (GET y POST), los dos resueltos por nombre."
          },
          "response": []
        },
        {
